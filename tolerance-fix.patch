From 1863f3b10c175ed4874b4396abf256d0327ffefd Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 12 Oct 2026 13:46:04 +0000
Subject: [PATCH] Raise convergence tolerance to 1e-4 (1e-5 is at float32 noise
 floor)

---
 README.md                          | 2 +-
 async/common.h                     | 8 ++++----
 harness_ml/INTEGRATION_CONTRACT.md | 2 +-
 harness_ml/experiment_spec.json    | 2 +-
 harness_ml/reference.py            | 2 +-
 harness_ml/run_experiments.py      | 2 +-
 harness_ml/solver_cli.py           | 2 +-
 7 files changed, 10 insertions(+), 10 deletions(-)

diff --git a/README.md b/README.md
index c40a2dc..45fa7b8 100644
--- a/README.md
+++ b/README.md
@@ -31,7 +31,7 @@ We solve 2D diffusion on a structured grid with a five-point **Jacobi** stencil
 1. **Equation (implicit transient step, so convergence takes tens to hundreds of iterations):**
    `u_new = (u_old + r * (sum of 4 neighbours) + dt * f) / (1 + 4r)`, where `r = alpha*dt/h^2`
 2. **D** = number of local sweeps a block performs in shared memory between halo refreshes from global memory.
-3. **Tolerance:** residual < 1e-5. **Residual interval:** M = 10.
+3. **Tolerance:** residual < 1e-4 (raised from 1e-5: 1 ulp of float32 at 100 is 7.6e-6, so 1e-5 sits at the rounding-noise floor and the stop point was luck-dependent). **Residual interval:** M = 10.
 4. **Results CSV:** see `results/SCHEMA.md`.
 5. **Compile for RTX 5060:** CUDA 12.8+, `-arch=sm_120`.
 
diff --git a/async/common.h b/async/common.h
index 969d0d2..e156a1d 100644
--- a/async/common.h
+++ b/async/common.h
@@ -15,9 +15,9 @@
 //   Initial interior u = 0. Fixed point = steady state, so convergence is SLOW
 //   (~N^2 iterations: reference.py gives 10700 iters at N=64, r=1).
 //   residual  = max |update| of one sweep, sampled every M=10 iterations.
-//   converged when residual < 1e-5 (strictly).
-//   NOTE: 1 ulp of float32 at 100 is 7.6e-6, just under tol, so the stop test sits at the
-//   float noise floor. Compile every solver with FMA off (nvcc -fmad=false,
+//   converged when residual < 1e-4 (strictly). (Was 1e-5, which sits at the float32 noise floor.)
+//   NOTE: 1 ulp of float32 at 100 is 7.6e-6, so the old tol of 1e-5 sat at the float noise
+//   floor (residual flickered 7.6e-6/1.1e-5/1.5e-5). 1e-4 is safely above it. Compile every solver with FMA off (nvcc -fmad=false,
 //   g++ -ffp-contract=off) so results match reference.py bit-for-bit.
 //
 // Layout: idx = y*N + x (row-major). Boundary ring is never updated.
@@ -39,7 +39,7 @@ struct Config {
     int       N         = 512;
     SourceType source   = SourceType::GAUSSIAN;
     double    r         = 1.0;         // alpha*dt/h^2
-    double    tol       = 1e-5;
+    double    tol       = 1e-4;
     int       M         = 10;          // residual interval (iterations)
     long long max_iters = 2000000;
     int       D         = 1;           // async: local sweeps per halo refresh
diff --git a/harness_ml/INTEGRATION_CONTRACT.md b/harness_ml/INTEGRATION_CONTRACT.md
index 6c47a41..5461888 100644
--- a/harness_ml/INTEGRATION_CONTRACT.md
+++ b/harness_ml/INTEGRATION_CONTRACT.md
@@ -14,7 +14,7 @@ Both executables must use `experiment_spec.json` as the source of truth:
 - update equation:
   `u_new = (u_old + r*(north+south+west+east) + dt*f)/(1+4*r)`
 - maximum absolute update as residual, checked every 10 iterations
-- convergence when residual is strictly below `1e-5`
+- convergence when residual is strictly below `1e-4`
 
 The same boundaries and source term must be retained on every local sweep. `D`
 is the number of local shared-memory sweeps between halo refreshes.
diff --git a/harness_ml/experiment_spec.json b/harness_ml/experiment_spec.json
index 2617e41..82ef1f3 100644
--- a/harness_ml/experiment_spec.json
+++ b/harness_ml/experiment_spec.json
@@ -27,7 +27,7 @@
   "strategies": ["sync", "D1", "D2", "D4", "D8"],
   "repeats": 3,
   "base_seed": 52,
-  "tolerance": 1e-5,
+  "tolerance": 1e-4,
   "residual_interval": 10,
   "max_iters": 2000000,
   "near_tie_fraction": 0.02,
diff --git a/harness_ml/reference.py b/harness_ml/reference.py
index 72295f8..b7e17af 100644
--- a/harness_ml/reference.py
+++ b/harness_ml/reference.py
@@ -42,7 +42,7 @@ def grid_after_iterations(config: ProblemConfig, iterations: int) -> np.ndarray:
 def solve_reference(
     config: ProblemConfig,
     *,
-    tolerance: float = 1.0e-5,
+    tolerance: float = 1.0e-4,
     residual_interval: int = 10,
     max_iters: int = 2_000_000,
 ) -> SolveResult:
diff --git a/harness_ml/run_experiments.py b/harness_ml/run_experiments.py
index 3be7f51..bf695e5 100644
--- a/harness_ml/run_experiments.py
+++ b/harness_ml/run_experiments.py
@@ -253,7 +253,7 @@ def main() -> None:
     parser.add_argument("--r-values", type=float, nargs="+", default=[1, 10, 100])
     parser.add_argument("--strategies", nargs="+", default=list(STRATEGIES), choices=STRATEGIES)
     parser.add_argument("--repeats", type=int, default=3)
-    parser.add_argument("--tolerance", type=float, default=1.0e-5)
+    parser.add_argument("--tolerance", type=float, default=1.0e-4)
     parser.add_argument("--residual-interval", type=int, default=10)
     parser.add_argument("--max-iters", type=int, default=2_000_000)
     parser.add_argument("--rerun", action="store_true")
diff --git a/harness_ml/solver_cli.py b/harness_ml/solver_cli.py
index 3139276..58d6034 100644
--- a/harness_ml/solver_cli.py
+++ b/harness_ml/solver_cli.py
@@ -20,7 +20,7 @@ def main() -> None:
     parser.add_argument("--strategy", default="sync")
     parser.add_argument("--run-id", type=int, default=1)
     parser.add_argument("--seed", type=int, default=52)
-    parser.add_argument("--tolerance", type=float, default=1.0e-5)
+    parser.add_argument("--tolerance", type=float, default=1.0e-4)
     parser.add_argument("--residual-interval", type=int, default=10)
     parser.add_argument("--max-iters", type=int, default=2_000_000)
     parser.add_argument("--grid-output", type=Path)
